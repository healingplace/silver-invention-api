{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth0": {
    "Domain": "https://<your-tenant>.auth0.com",
    "Audience": "https://your-api-identifier"
  },
  "AzureBlob": {
    "UseEmulator": false,
    "StorageAccountUri": "https://<your-account>.blob.core.windows.net",
    "ContainerName": "documents"
  }
}
